# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster> with your own values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pulsechat?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_another_strong_random_secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is sufficient
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── File uploads ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_FILE_SIZE_MB=25

# ─── WebRTC TURN server ────────────────────────────────────────────────────────
# STUN (Google) is used by default — free, no config needed for same-network calls.
# TURN is REQUIRED for cross-network calls (laptop ↔ mobile, different WiFi networks).
#
# Option 1 (recommended): Sign up free at https://dashboard.metered.ca
#   Set TURN_URL to just the domain: turn:a.relay.metered.ca
#   The server automatically adds port 80, 3478, 443/tcp, 443/tls variants.
#
# Option 2: Use the open relay (less reliable):
TURN_URL=turn:openrelay.metered.ca
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject

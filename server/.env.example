# ─── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get your connection string from https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster> with your own values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pulsechat?retryWrites=true&w=majority

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ─── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_SECRET=replace_with_another_strong_random_secret

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Sign up at https://cloudinary.com — free tier is sufficient
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── File uploads ──────────────────────────────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
MAX_FILE_SIZE_MB=25

# ─── WebRTC TURN server ────────────────────────────────────────────────────────
# STUN (stun.l.google.com) is used by default — no config needed.
# TURN is required for users behind strict NATs/firewalls.
# Get a free TURN server at https://www.metered.ca/tools/openrelay/ or deploy coturn.
TURN_URL=turn:openrelay.metered.ca:80
TURN_USERNAME=openrelayproject
TURN_CREDENTIAL=openrelayproject
